APP_NAME=gampil
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://gampil-akses.vercel.app

LOG_CHANNEL=stderr
LOG_LEVEL=info

# ==========================================
# DATABASE: FULL SUPABASE POSTGRESQL
# ==========================================
# Opsi 1: Menggunakan Single Connection String URI (Supabase -> Project Settings -> Database -> URI):
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Opsi 2: Menggunakan Parameter Terpisah:
# DB_CONNECTION=pgsql
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=6543
# DB_DATABASE=postgres
# DB_USERNAME=postgres.your-project-ref
# DB_PASSWORD=your-database-password
# DB_SSLMODE=require

# ==========================================
# SERVERLESS DRIVERS FOR VERCEL
# ==========================================
SESSION_DRIVER=cookie
CACHE_STORE=array
FILESYSTEM_DISK=public

# ==========================================
# DISCORD TELEMETRY
# ==========================================
DISCORD_WEBHOOK_URL=
ADMIN_EMAIL=admin@r4ven.local
ADMIN_PASSWORD=admin12345
